{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/security-scan.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm list:*)",
      "Bash(npm i:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npx ruflo:*)",
      "Bash(node:*)",
      "Bash(vercel:*)",
      "Bash(mkdir:*)",
      "PowerShell(git *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(node *)",
      "PowerShell(vercel *)",
      "PowerShell(New-Item *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Copy-Item *)",
      "mcp__plugin_vercel_vercel__list_deployments",
      "mcp__plugin_vercel_vercel__get_project"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(git rm:*)",
      "Bash(unlink *)",
      "PowerShell(Remove-Item *)",
      "Write(.env*)",
      "Edit(.env*)",
      "Write(**/package.json)",
      "Edit(**/package.json)",
      "Write(**/package-lock.json)",
      "Edit(**/package-lock.json)",
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/settings.json)",
      "Write(**/CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Write(**/middleware.ts)",
      "Edit(**/middleware.ts)",
      "Write(**/webhook*)",
      "Edit(**/webhook*)"
    ]
  }
}
